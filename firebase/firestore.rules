rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function admin() {return request.auth != null && request.auth.token.email_verified == true && request.auth.token.email == 'sziraksz@gmail.com';}
  function validQty(q,k) {return q[k] is int && q[k]>=0 && q[k]<=20;}
  function totalQty(q) {return q.bS+q.bM+q.bL+q.bXL+q.bXXL+q.wS+q.wM+q.wL+q.wXL+q.wXXL;}
  function validQ(q) {return q is map && q.keys().hasAll(['bS','bM','bL','bXL','bXXL','wS','wM','wL','wXL','wXXL']) && q.keys().hasOnly(['bS','bM','bL','bXL','bXXL','wS','wM','wL','wXL','wXXL']) && validQty(q,'bS') && validQty(q,'bM') && validQty(q,'bL') && validQty(q,'bXL') && validQty(q,'bXXL') && validQty(q,'wS') && validQty(q,'wM') && validQty(q,'wL') && validQty(q,'wXL') && validQty(q,'wXXL') && totalQty(q)>0 && totalQty(q)<=50;}
  function buyer() {return request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com' && request.auth.token.email_verified == true && request.auth.token.email is string;}
  function validClass(c) {return c in ['7M', '8M', '9M', '10M', '11M', '12M', '9T', '10T', '11T', '12T', '9A', '10A', '11A', '12A', '9B', '10B', '11B', '12B', '9C', '10C', '11C', '12C', '9D', '10D', '11D', '12D', '9AJTP', 'Tanár', 'Külső'];}
  function open() {let c=get(/databases/$(database)/documents/config/campaign).data;return request.time >= c.startAt && request.time < c.endAt;}
  match /config/campaign {
   allow read: if true;
   allow create,update: if admin() && request.resource.data.keys().hasOnly(['start','end','startAt','endAt','pickup']) && request.resource.data.start is string && request.resource.data.end is string && request.resource.data.startAt is timestamp && request.resource.data.endAt is timestamp && request.resource.data.endAt>request.resource.data.startAt && request.resource.data.pickup is string && request.resource.data.pickup.size()<=500;
   allow delete: if false;
  }
  match /profiles/{uid} {
   allow get: if (request.auth != null && request.auth.uid == uid) || admin();
   allow list: if admin();
   allow create,update: if buyer() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['name','schoolClass','email','updatedAt']) && request.resource.data.name is string && request.resource.data.name.size() >= 3 && request.resource.data.name.size() <= 100 && validClass(request.resource.data.schoolClass) && request.resource.data.email == request.auth.token.email && request.resource.data.updatedAt == request.time;
   allow delete: if false;
  }
  match /orders/{id} {
   allow get: if request.auth!=null && (!exists(/databases/$(database)/documents/orders/$(id)) || resource.data.owner==request.auth.uid || admin());
   allow list: if admin() || (request.auth != null && resource.data.owner == request.auth.uid);
   allow create: if buyer() && open() && id.matches('RMG-[A-F0-9]{8}-[A-F0-9]{4}-[A-F0-9]{4}-[A-F0-9]{4}-[A-F0-9]{12}') && request.resource.data.keys().hasOnly(['id','owner','name','email','schoolClass','q','total','paid','collected','createdAt']) && request.resource.data.id==id && request.resource.data.owner==request.auth.uid && request.resource.data.name is string && request.resource.data.name.size()>=3 && request.resource.data.name.size()<=100 && request.resource.data.email == request.auth.token.email && request.resource.data.email.size()<=200 && request.resource.data.schoolClass is string && validClass(request.resource.data.schoolClass) && validQ(request.resource.data.q) && request.resource.data.total==totalQty(request.resource.data.q)*10000 && request.resource.data.paid==0 && request.resource.data.collected==0 && request.resource.data.createdAt==request.time;
   allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paid','collected']) && request.resource.data.paid in [0,1] && request.resource.data.collected in [0,1];
   allow delete: if false;
  }
 }
}
